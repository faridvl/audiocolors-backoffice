# URLs del backend standard-saas-api (compartido con Zynka).
# AudioColors es un tenant mas: el aislamiento lo resuelve el JWT.
# Local apunta al ambiente "develop" de Railway (mismo que dev-backoffice.audiocolors.com).
# Para probar contra el ambiente real, usar identity.standard-saas.com / records.standard-saas.com.
NEXT_PUBLIC_IDENTITY_API_URL=https://dev-identity.standard-saas.com
NEXT_PUBLIC_MEDICAL_RECORDS_API_URL=https://dev-records.standard-saas.com
